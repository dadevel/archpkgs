pkgname=rusthound-ce
pkgver=2.5.27
pkgrel=1
pkgdesc='Active Directory data collector for BloodHound Community Edition'
url='https://github.com/g0h4n/RustHound-CE'
arch=(x86_64)
license=(MIT)
depends=(gcc-libs glibc krb5)
makedepends=(git rust clang pkgconf)
_commit=6c3aabaf4ffa7f3f73283729c16c9e74e54db7cc
source=("${pkgname}::git+${url}.git#commit=${_commit}")
sha256sums=(SKIP)

prepare() {
    cd "${srcdir}/${pkgname}"
    cargo fetch --locked
}

build() {
    cd "${srcdir}/${pkgname}"
    CFLAGS="${CFLAGS/-flto=auto/}" RUSTUP_TOOLCHAIN=stable cargo build --release --frozen
}

package() {
    cd "${srcdir}/${pkgname}"
    install -Dm755 target/release/rusthound-ce "${pkgdir}/opt/archpkgs/bin/rusthound-ce"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
